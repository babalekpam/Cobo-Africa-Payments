# IAPAY deployment settings.  cp .env.example .env  and fill in the REQUIRED section.
# NEVER commit .env. Generate secrets with:  openssl rand -base64 48

############################ REQUIRED ############################
# Public address clients use to reach the platform (no trailing slash). Used for CORS and links.
PUBLIC_URL=https://pay.example.com

# Database password (the database itself is private to the compose network).
POSTGRES_PASSWORD=change-me-use-openssl-rand-base64-32

# Signs login sessions. Long and random; changing it logs everyone out.
JWT_SECRET=change-me-openssl-rand-base64-48

# First administrator, created once at first start (never modified afterwards). The password must be
# at least 8 characters and not a common password — use a long passphrase.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-passphrase
ADMIN_NAME=Platform Administrator

# Encrypts participant (bank) gateway secrets at rest. >= 32 characters. LOSING THIS KEY MEANS EVERY
# STORED PARTICIPANT SECRET MUST BE ROTATED, so back it up in your secrets manager, separately from the database.
GATEWAY_SECRETS_KEY=change-me-openssl-rand-base64-48

# Live exchange rates (https://www.exchangerate-api.com). REQUIRED for real use: without it the platform
# only has built-in static rates and, in production, refuses to move money between institutions.
EXCHANGERATE_API_KEY=

############################ YOUR SCHEME ############################
# sandbox = test money for demos and client testing (self-service test funding, simulated payouts,
# a "SANDBOX" banner on every page). live = real money. Defaults to live in production.
IAPAY_ENVIRONMENT=live
# Everything below describes YOUR deployment — nothing in the platform is tied to a country.
SCHEME_NAME=IAPAY
SCHEME_HOME_PARTICIPANT_NAME=Your Institution Name
SCHEME_HOME_COUNTRY=KE
SCHEME_HOME_CURRENCY=USD
# Keep false: true creates fictional member banks (demo only).
SCHEME_SEED_DEMO_PARTICIPANTS=false

# Participant gateway risk limits. A bank cannot send until you give it a cap (operator API / admin).
# 0 = fail closed (recommended)
GATEWAY_DEFAULT_NET_DEBIT_CAP_USD=0
# per-payment ceiling for bank-originated payments
GATEWAY_MAX_SINGLE_AMOUNT_USD=10000
SETTLEMENT_INTERVAL_HOURS=4

############################ SANCTIONS SCREENING ############################
# Licensed sanctions screening (OpenSanctions: consolidated OFAC, UN, EU, UK and other official lists).
# Strongly recommended for live use. Without a key only the small built-in list is checked.
# If the provider is configured but unreachable, payments are refused (fail closed), never waved through.
SANCTIONS_API_KEY=
# SANCTIONS_API_URL=https://api.opensanctions.org
# SANCTIONS_DATASET=sanctions

############################ SECURITY (set for production) ############################
# mobile-money callbacks
WEBHOOK_CALLBACK_SECRET=change-me-openssl-rand-base64-32
# signs webhooks sent to merchants
WEBHOOK_SIGNING_SECRET=change-me-openssl-rand-base64-32
# your USSD aggregator presents this
USSD_GATEWAY_SECRET=change-me-openssl-rand-base64-32
# only if you use Flutterwave
FLUTTERWAVE_WEBHOOK_HASH=
JWT_EXPIRES_IN=24h

############################ OPTIONAL INTEGRATIONS ############################
# Leave blank what you do not use; each is a graceful no-op when unset.
HTTP_PORT=80
# Email (any one): SMTP_*, SENDGRID_API_KEY, or MAILGUN_*
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
# SMS for key verification (any one): Africa's Talking or Twilio
AT_API_KEY=
AT_USERNAME=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Mobile money / payment providers (only those you contract with)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORT_CODE=
MPESA_PASSKEY=
MTN_COLLECTION_SUBSCRIPTION_KEY=
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
FLUTTERWAVE_SECRET_KEY=
