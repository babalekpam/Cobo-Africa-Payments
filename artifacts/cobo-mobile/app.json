{
  "expo": {
    "name": "COBO Africa",
    "slug": "cobo-africa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0F2B4C"
    },
    "ios": {
      "bundleIdentifier": "com.cobo.africa",
      "supportsTablet": false
    },
    "android": {
      "package": "com.cobo.africa",
      "adaptiveIcon": {
        "backgroundColor": "#0F2B4C"
      }
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "scheme": "cobo",
    "experiments": {
      "typedRoutes": true
    }
  }
}
